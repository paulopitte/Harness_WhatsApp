# ==============================================================================
# WhatsApp AI Harness MVP — Template de Variáveis de Ambiente (.env.example)
# Copie para .env: cp .env.example .env
# NUNCA versione chaves reais no Git (Constitution Principle VIII)
# ==============================================================================

# 1. Ambiente e Config
HARNESS_ENV=development
HARNESS_CONFIG_PATH=configs/harness.yaml

# 2. Banco de Dados PostgreSQL 16 + pgvector (Fila, Threads, Memória e RAG)
POSTGRES_USER=harness
POSTGRES_PASSWORD=harness_secret
POSTGRES_DB=whatsapp_harness
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://harness:harness_secret@localhost:5432/whatsapp_harness

# 3. Segurança da Borda (Meta Cloud API) e Admin API
WHATSAPP_VERIFY_TOKEN=dev_verify_token_123
WHATSAPP_APP_SECRET=dev_app_secret_change_in_prod
WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
ADMIN_API_KEY=dev_admin_api_key_change_in_prod

# 4. Provedores de LLM (ModelFactory Agnóstica — preencha apenas o que for usar)
GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# 5. Banco Vetorial Externo Opcional (quando rag.provider="qdrant")
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# 6. Observabilidade & PromptOps (Langfuse + OpenTelemetry)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_SERVICE_NAME=whatsapp-harness

